<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Usuarios</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h1>Usuarios</h1>
    <!-- Formulario para agregar un nuevo usuario -->
    <form id="addUserForm" action="/add" method="post">
        <label for="name">Nombre:</label>
        <input type="text" id="name" name="nombre" required><br><br>

        <label for="email">Correo Electr&oacute;nico:</label>
        <input type="email" id="email" name="correo" required><br><br>

        <button type="submit">Agregar</button>
    </form>
    <hr>
    <!-- Tabla para mostrar los usuarios -->
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Correo Electr&oacute;nico</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <!-- Bucle para mostrar cada usuario en una fila de la tabla con EJS -->
        <tbody>
            <% users.forEach(usuario => { %>
                <tr>
                    <td><%= usuario.id %></td>
                    <td><%= usuario.nombre %></td>
                    <td><%= usuario.correo %></td>
                    <td>
                        <a href="/edit/<%= usuario.id %>">Editar</a>
                        <a href="/delete/<%= usuario.id %>">Eliminar</a>
                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>

    <script>
    const form = document.getElementById('addUserForm');
    const nombre = document.getElementById('name');
    const correo = document.getElementById('email');

    // Cambio: enviar el alta con fetch para alertar correo duplicado sin limpiar el formulario.
    form.addEventListener('submit', async e => {
        e.preventDefault();

        try {
            const res = await fetch('/add', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    nombre: nombre.value,
                    correo: correo.value
                })
            });

            const data = await res.json();

            if (!res.ok) {
                alert(data.error);
                correo.focus();
                correo.select();
                return;
            }

            alert(data.mensaje);
            form.reset();
            location.reload();
        } catch (error) {
            alert('No se pudo procesar la solicitud. Intente nuevamente.');
        }
    });
    </script>
</body>
</html>
